---
import ChorusMark from '../components/ChorusMark.svelte'
import { LINKS, YOUTUBE_EARLY_ACCESS } from '../lib/site'

interface Props {
    title: string
    description?: string
    /** Pin the page to one extension (its install and uninstall pages); otherwise the visitor picks. */
    host?: 'spotify' | 'youtube'
}

const {
    title,
    description = 'Snips, presets, speed, EQ, reverb and more, inside Spotify and YouTube.',
    host
} = Astro.props
const currentYear = new Date().getFullYear()

const navLinks = [
    { href: '/#showcase', label: 'Features' },
    { href: '/#presets', label: 'Presets', dot: true },
    { href: '/#looks', label: 'Looks', pro: true },
    { href: '/#tour', label: 'Tour' },
    { href: LINKS.docs, label: 'Docs' },
    { href: '/#faq', label: 'FAQ' }
]

import '../styles/global.css'
---

<!doctype html>
<html lang="en" data-host={host === 'youtube' ? 'youtube' : undefined}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:image" content={new URL('/icon/128.png', Astro.site).href} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />

        <link rel="icon" type="image/png" href="/icon/32.png" sizes="32x32" />
        <link rel="icon" type="image/png" href="/icon/16.png" sizes="16x16" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&family=Space+Mono:wght@400;700&display=swap"
            rel="stylesheet"
        />

        <!-- The host (Spotify or YouTube) the page shows, before first paint: a pinned page wins and is
             remembered for the next visit, then ?host=, then the last visit. -->
        <script is:inline define:vars={{ pinned: host ?? null }}>
            try {
                if (pinned) {
                    localStorage.setItem('chorus-host', pinned)
                } else {
                    const choice =
                        new URLSearchParams(location.search).get('host') || localStorage.getItem('chorus-host')
                    if (choice === 'youtube') document.documentElement.dataset.host = 'youtube'
                }
            } catch {}
        </script>

        <title>{title}</title>
    </head>
    <body class="landing min-h-screen bg-[#0a0a0a] font-body text-[#f5f5f7] antialiased">
        <nav class="sticky top-0 z-50 px-4 py-3.5 sm:px-6">
            <div
                class="mx-auto flex max-w-290 items-center justify-between gap-3 rounded-full border border-white/10 bg-[#141414]/70 py-2 pr-2 pl-4.5 backdrop-blur-xl"
            >
                <a href="/" class="flex items-center gap-2.5">
                    <ChorusMark size={26} />
                    <span class="font-display text-[19px] font-bold">Chorus</span>
                </a>
                <div class="hidden items-center gap-6 text-sm text-[#b3b3b3] md:flex">
                    {
                        navLinks.map((link) => (
                            <a href={link.href} class="inline-flex items-center gap-1.5 transition hover:text-white">
                                {link.label}
                                {link.dot && <span class="size-1.5 rounded-full bg-host shadow-[0_0_8px_var(--host)]" />}
                                {link.pro && (
                                    <span class="rounded-full border border-white/20 px-1.5 py-0.5 font-code text-[9px] tracking-[0.12em] text-white">
                                        PRO
                                    </span>
                                )}
                            </a>
                        ))
                    }
                </div>
                <div class="flex items-center gap-2">
                    <a
                        href={LINKS.chrome}
                        data-store-link
                        data-firefox-href={LINKS.firefox}
                        data-firefox-label="Add to Firefox"
                        class="inline-flex min-h-10 items-center rounded-full bg-host-strong px-4.5 text-sm font-semibold text-host-ink yt:hidden"
                    >
                        <span data-store-label>Add to Chrome</span>
                    </a>
                    <a
                        href={YOUTUBE_EARLY_ACCESS}
                        class="hidden min-h-10 items-center rounded-full bg-host-strong px-4.5 text-sm font-semibold text-host-ink yt:inline-flex"
                    >
                        Early access
                    </a>
                    <details class="group relative md:hidden">
                        <summary
                            class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-white/15 [&::-webkit-details-marker]:hidden"
                            aria-label="Menu"
                        >
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden"></path>
                                <path d="M6 6l12 12M18 6 6 18" class="hidden group-open:block"></path>
                            </svg>
                        </summary>
                        <div class="absolute top-12 right-0 flex w-56 flex-col rounded-2xl border border-white/10 bg-[#141414] p-2 shadow-2xl">
                            {
                                navLinks.map((link) => (
                                    <a href={link.href} class="rounded-xl px-3 py-2.5 text-[15px] text-[#dcdcdc] hover:bg-white/5">
                                        {link.label}
                                        {link.pro && <span class="ml-1.5 font-code text-[10px] text-[#8a8a8a]">PRO</span>}
                                    </a>
                                ))
                            }
                        </div>
                    </details>
                </div>
            </div>
        </nav>

        <main>
            <slot />
        </main>

        <footer class="border-t border-white/7">
            <div class="mx-auto grid max-w-290 grid-cols-2 gap-10 px-6 py-14 md:grid-cols-5">
                <div class="col-span-2 flex flex-col gap-3">
                    <a href="/" class="flex items-center gap-2.5">
                        <ChorusMark size={24} />
                        <span class="font-display text-lg font-bold">Chorus</span>
                    </a>
                    <p class="max-w-xs text-sm leading-relaxed text-[#8a8a8a]">
                        A studio rack inside the player you already use. Free and open source.
                    </p>
                </div>
                <div class="flex flex-col gap-2.5 text-sm">
                    <h4 class="mb-1 font-code text-[11px] tracking-[0.18em] text-[#7f7f7f]">SPOTIFY</h4>
                    <a href={LINKS.chrome} class="text-[#b3b3b3] hover:text-white">Chrome Web Store</a>
                    <a href={LINKS.firefox} class="text-[#b3b3b3] hover:text-white">Firefox Add-ons</a>
                    <a href="/downloads/" class="text-[#b3b3b3] hover:text-white">Downloads</a>
                    <a href="/changelog/" class="text-[#b3b3b3] hover:text-white">Changelog</a>
                </div>
                <div class="flex flex-col gap-2.5 text-sm">
                    <h4 class="mb-1 font-code text-[11px] tracking-[0.18em] text-[#7f7f7f]">YOUTUBE</h4>
                    <a href={YOUTUBE_EARLY_ACCESS} class="text-[#b3b3b3] hover:text-white">Early access</a>
                    <span class="text-[#6f6f6f]">YouTube and YouTube Music</span>
                </div>
                <div class="flex flex-col gap-2.5 text-sm">
                    <h4 class="mb-1 font-code text-[11px] tracking-[0.18em] text-[#7f7f7f]">MORE</h4>
                    <a href={LINKS.docs} class="text-[#b3b3b3] hover:text-white">Docs</a>
                    <a href="/support/" class="text-[#b3b3b3] hover:text-white">Support</a>
                    <a href="/blog/" class="text-[#b3b3b3] hover:text-white">Blog</a>
                    <a href="/demo/" class="text-[#b3b3b3] hover:text-white">Live demo</a>
                    <a href={LINKS.discord} class="text-[#b3b3b3] hover:text-white">Discord</a>
                    <a href={LINKS.github} class="text-[#b3b3b3] hover:text-white">GitHub</a>
                    <a href={LINKS.kofi} class="text-[#b3b3b3] hover:text-white">Ko-fi</a>
                </div>
            </div>
            <div class="border-t border-white/7">
                <div class="mx-auto flex max-w-290 flex-wrap justify-between gap-3 px-6 py-6 text-[13px] text-[#7f7f7f]">
                    <span>&copy; {currentYear} Chorus. MIT licensed.</span>
                    <span>Not affiliated with Spotify or YouTube.</span>
                </div>
            </div>
        </footer>

        <!-- Firefox visitors get the add-on link in place of the Chrome Web Store. -->
        <script is:inline>
            if (/firefox/i.test(navigator.userAgent)) {
                for (const link of document.querySelectorAll('[data-store-link]')) {
                    link.href = link.dataset.firefoxHref
                    const label = link.querySelector('[data-store-label]')
                    if (label) label.textContent = link.dataset.firefoxLabel
                }
            }
        </script>
    </body>
</html>
