---
import Landing from '../layouts/Landing.astro'
import HostSwitch from '../components/home/HostSwitch.svelte'
import HostVideo from '../components/home/HostVideo.svelte'
import Marquee from '../components/home/Marquee.astro'
import Showcase from '../components/home/Showcase.svelte'
import PresetsDemo from '../components/home/PresetsDemo.svelte'
import Bento from '../components/home/Bento.astro'
import Anywhere from '../components/home/Anywhere.svelte'
import Looks from '../components/home/Looks.svelte'
import Tour from '../components/home/Tour.svelte'
import { LINKS, YOUTUBE_EARLY_ACCESS } from '../lib/site'

const spotifyBrowsers = ['Chrome', 'Firefox', 'Edge', 'Opera', 'Brave', 'Vivaldi']
const youtubeBrowsers = ['Chrome', 'Firefox']

// [label, which host has it]
const more: [string, 'both' | 'spotify' | 'youtube'][] = [
    ['Snips library', 'both'],
    ['Stereo width', 'both'],
    ['Texture', 'both'],
    ['Custom seek steps', 'both'],
    ['Keyboard shortcuts', 'both'],
    ['One-key snip marking', 'both'],
    ['Backup and restore', 'both'],
    ['One-key on / off', 'both'],
    ['Snip from the lyrics', 'spotify'],
    ['Discographies', 'spotify'],
    ['New releases', 'spotify'],
    ['Per-track volume', 'spotify'],
    ['Share a look as a file', 'spotify'],
    ['Block a channel', 'youtube'],
    ['Block from any card', 'youtube'],
    ['YouTube Music', 'youtube']
]

const faqs = [
    ['Is Chorus free?', 'Yes. Both extensions are free and open source under the MIT license.'],
    ['Is my audio uploaded anywhere?', 'No. Effects and vocal separation run in your browser tab. Nothing is sent to a server.'],
    [
        'Does Chorus touch YouTube ads?',
        'No. During an ad Chorus steps aside: no snips, skips or speed changes until the video starts. It never hides, mutes or skips ads.'
    ],
    [
        'Which browsers?',
        'Chorus for Spotify: Chrome, Firefox, Edge, Opera, Brave and Vivaldi. Chorus for YouTube: Chrome and Firefox.'
    ],
    [
        'Does picture-in-picture work everywhere?',
        'It needs a Chromium browser such as Chrome or Edge. Firefox has no document picture-in-picture yet, so there the toolbar popup is the way to control Chorus from another tab.'
    ]
]

const floatChip =
    'absolute z-3 hidden items-center gap-2.5 rounded-xl border border-white/12 bg-[#161616]/92 px-3.5 py-2.5 text-[13px] shadow-[0_18px_40px_rgba(0,0,0,0.55)] md:inline-flex'
---

<Landing title="Chorus · A studio rack for Spotify and YouTube">
    <header class="relative px-6 pt-16 pb-24">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 -top-30 overflow-hidden">
            <div class="absolute top-10 left-[8%] size-130 animate-[drift-a_16s_ease-in-out_infinite] rounded-full bg-host opacity-16 blur-[110px]"></div>
            <div class="absolute top-30 right-[6%] size-115 animate-[drift-b_19s_ease-in-out_infinite] rounded-full bg-[#ffa42b] opacity-9 blur-[110px]"></div>
            <div class="absolute top-90 left-[40%] size-105 animate-[drift-c_14s_ease-in-out_infinite] rounded-full bg-[#1b6b63] opacity-22 blur-[110px]"></div>
        </div>

        <div class="relative mx-auto flex max-w-290 flex-wrap items-center gap-14">
            <div class="flex min-w-0 flex-[1_1_440px] flex-col gap-6">
                <span class="inline-flex items-center gap-2 self-start rounded-full border border-white/10 bg-white/6 px-3.5 py-1.75 text-[13px] text-[#dcdcdc]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--host)" aria-hidden="true" class="animate-[sparkle_3s_ease-in-out_infinite]"><path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z"></path></svg>
                    Free · open source · MIT
                </span>
                <h1 class="m-0 bg-[linear-gradient(180deg,#ffffff_30%,#9a9a9a)] bg-clip-text font-display text-[clamp(46px,6.2vw,78px)] leading-[0.97] font-bold tracking-[-0.035em] text-transparent">
                    Your player, with a studio rack.
                </h1>
                <p class="m-0 max-w-125 text-lg leading-relaxed text-[#b3b3b3]">
                    Loop the chorus, skip the skits, slow a solo without the chipmunk effect, and put it all in a concert hall.
                    Inside the player you already use.
                </p>
                <HostSwitch client:load />
                <div class="flex flex-wrap gap-3">
                    <a
                        href={LINKS.chrome}
                        data-store-link
                        data-firefox-href={LINKS.firefox}
                        data-firefox-label="Add to Firefox, free"
                        class="inline-flex min-h-13 items-center gap-2.5 rounded-xl bg-host-strong px-6 text-base font-semibold text-host-ink shadow-[inset_0_0_0_1px_rgba(255,255,255,0.1),0_12px_40px_color-mix(in_srgb,var(--host)_35%,transparent)] yt:hidden"
                    >
                        <span data-store-label>Add to Chrome, free</span>
                    </a>
                    <a
                        href={YOUTUBE_EARLY_ACCESS}
                        class="hidden min-h-13 items-center gap-2.5 rounded-xl bg-host-strong px-6 text-base font-semibold text-host-ink shadow-[inset_0_0_0_1px_rgba(255,255,255,0.1),0_12px_40px_color-mix(in_srgb,var(--host)_38%,transparent)] yt:inline-flex"
                    >
                        Get early access
                    </a>
                    <a
                        href="#tour"
                        class="inline-flex min-h-13 items-center gap-2.5 rounded-xl border border-white/12 bg-white/6 px-5 text-base font-semibold"
                    >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12-7.5z"></path></svg>
                        Watch 0:50 tour
                    </a>
                </div>
                <div class="flex flex-wrap items-center gap-x-4.5 gap-y-2 text-[13px]">
                    <span class="font-code text-[11px] tracking-[0.15em] text-[#7f7f7f]">RUNS IN</span>
                    {spotifyBrowsers.map((name) => <span class="font-medium text-[#b3b3b3] yt:hidden">{name}</span>)}
                    {youtubeBrowsers.map((name) => <span class="hidden font-medium text-[#b3b3b3] yt:inline">{name}</span>)}
                </div>
            </div>

            <div class="relative min-w-0 flex-[1.15_1_500px]">
                <div class:list={[floatChip, '-bottom-5 -left-7 animate-[float_5s_ease-in-out_infinite]']}>
                    <span class="font-code text-host">looped ×3</span><span class="text-[#8a8a8a]">1:07 → 2:06</span>
                </div>
                <div class:list={[floatChip, '-top-4.5 -right-5.5 animate-[float_6s_ease-in-out_-2s_infinite]']}>
                    <span class="size-2 rounded-full bg-host shadow-[0_0_10px_var(--host)]"></span>Saved for this track
                </div>
                <div
                    class="animate-[beam_5s_linear_infinite] rounded-[20px] p-px shadow-[0_50px_120px_rgba(0,0,0,0.6),0_0_80px_color-mix(in_srgb,var(--host)_16%,transparent)]"
                    style="background: conic-gradient(from var(--beam), rgba(255,255,255,0.1) 0deg, rgba(255,255,255,0.1) 240deg, var(--host) 315deg, #ffffff 330deg, rgba(255,255,255,0.1) 360deg)"
                >
                    <div class="overflow-hidden rounded-[19px] bg-[#0b0b0b]">
                        <HostVideo
                            client:load
                            sources={{ spotify: '/media/snip.mp4', youtube: '/media/snip-yt.mp4' }}
                            label="The Chorus snip editor, recorded"
                            class="block h-auto w-full"
                        />
                    </div>
                </div>
            </div>
        </div>
    </header>

    <Marquee />
    <Showcase client:visible />
    <PresetsDemo client:visible />
    <Bento />
    <Anywhere client:visible />
    <Looks client:visible />

    <section class="mx-auto max-w-290 px-6 pt-6 pb-24">
        <div class="reveal relative flex flex-col gap-7 overflow-hidden rounded-[26px] border border-white/8 bg-[#111] p-[clamp(28px,4vw,48px)]">
            <div
                aria-hidden="true"
                class="absolute -bottom-65 left-1/2 -ml-112.5 h-105 w-225 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--host)_16%,transparent),transparent)]"
            >
            </div>
            <div class="relative flex flex-wrap items-end justify-between gap-4">
                <div class="flex max-w-140 flex-col gap-3">
                    <span class="font-code text-xs tracking-[0.2em] text-host">
                        <span class="yt:hidden">LIVES INSIDE SPOTIFY</span><span class="hidden yt:inline">LIVES INSIDE YOUTUBE</span>
                    </span>
                    <h2 class="m-0 font-display text-[clamp(30px,3.8vw,46px)] leading-[1.02] font-bold tracking-[-0.03em]">
                        <span class="yt:hidden">No new app. No new tab.</span><span class="hidden yt:inline">In the player you already use.</span>
                    </h2>
                </div>
                <p class="m-0 max-w-95 text-base leading-relaxed text-[#b3b3b3]">
                    <span class="yt:hidden">Controls graft into the player bar: snip, block, speed, and a Chorus volume that goes past 100%.</span>
                    <span class="hidden yt:inline">Chorus buttons sit in the video controls, and your snips show up as marks on the seek bar.</span>
                </p>
            </div>
            <div class="relative overflow-hidden rounded-[14px] border border-white/10 bg-[#0b0b0b]">
                <video
                    src="/media/player-bar.mp4"
                    autoplay
                    loop
                    muted
                    playsinline
                    aria-label="Chorus controls in the Spotify player bar, recorded"
                    class="block h-auto w-full yt:hidden"
                ></video>
                <div class="hidden flex-wrap items-center gap-x-5.5 gap-y-4 bg-[#141414] px-5 py-4.5 yt:flex">
                    <div class="relative h-1 flex-[1_1_100%] rounded-sm bg-white/25">
                        <div class="absolute inset-y-0 left-0 w-[30%] bg-[#ff0033]"></div>
                        <div class="absolute -inset-y-0.75 left-[30%] w-[26%] rounded-[3px] border-x-2 border-[#ff0033] bg-[#ff0033]/30"></div>
                    </div>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z"></path></svg>
                    <span class="font-code text-xs text-[#dcdcdc]">1:24 / 4:03</span>
                    <span class="ml-auto inline-flex gap-3.5 rounded-full bg-[#ff0033]/14 px-3 py-1.5 text-[#ff4d6d]">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M20 4 8.12 15.88M14.47 14.48 20 20M8.12 8.12 12 12"></path></svg>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m12 14 4-4"></path><path d="M3.34 19a10 10 0 1 1 17.32 0"></path></svg>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m4.9 4.9 14.2 14.2"></path></svg>
                    </span>
                </div>
            </div>
        </div>
    </section>

    <Tour client:visible />

    <section class="mx-auto flex max-w-290 flex-col items-center gap-9 px-6 pt-6 pb-24">
        <h2 class="reveal m-0 font-display text-[clamp(44px,7vw,88px)] leading-none font-bold tracking-[-0.04em]">And more.</h2>
        <div class="flex max-w-240 flex-wrap justify-center gap-3">
            {
                more.map(([label, where], i) => (
                    <span
                        class:list={[
                            'popin items-center gap-2.5 rounded-full border border-white/9 bg-[#141414] px-5 py-3.5 text-base font-medium',
                            where === 'both' && 'inline-flex',
                            where === 'spotify' && 'inline-flex yt:hidden',
                            where === 'youtube' && 'hidden yt:inline-flex'
                        ]}
                        style={`animation-range: entry ${(i % 4) * 6}% cover ${30 + (i % 4) * 6}%`}
                    >
                        <span class="size-2 rotate-45 rounded-[2px] bg-host" />
                        {label}
                    </span>
                ))
            }
        </div>
    </section>

    <section id="faq" class="mx-auto flex max-w-205 scroll-mt-24 flex-col gap-6 px-6 pt-6 pb-24">
        <h2 class="reveal m-0 text-center font-display text-[clamp(32px,4vw,48px)] font-bold tracking-[-0.03em]">Questions</h2>
        <div class="flex flex-col gap-2.5">
            {
                faqs.map(([question, answer], i) => (
                    <details class="group reveal overflow-hidden rounded-2xl border border-white/8 bg-[#121212]" open={i === 0}>
                        <summary class="flex min-h-15 cursor-pointer list-none items-center justify-between gap-4 px-5.5 text-[17px] font-semibold [&::-webkit-details-marker]:hidden">
                            {question}
                            <span class="inline-flex text-host transition-transform duration-300 group-open:rotate-45">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14" />
                                </svg>
                            </span>
                        </summary>
                        <p class="m-0 px-5.5 pb-5 text-[15px] leading-relaxed text-[#b3b3b3]">{answer}</p>
                    </details>
                ))
            }
        </div>
    </section>

    <section class="mx-auto max-w-290 px-6 pb-24">
        <div class="reveal relative flex flex-col items-center gap-5.5 overflow-hidden rounded-[28px] border border-white/8 bg-[#111] px-6 py-[clamp(40px,6vw,80px)] text-center">
            <div aria-hidden="true" class="absolute -top-30 left-[20%] size-95 animate-[drift-a_14s_ease-in-out_infinite] rounded-full bg-host opacity-18 blur-[90px]"></div>
            <div aria-hidden="true" class="absolute right-[15%] -bottom-40 size-95 animate-[drift-b_16s_ease-in-out_infinite] rounded-full bg-[#5865f2] opacity-20 blur-[90px]"></div>
            <h2 class="relative m-0 font-display text-[clamp(34px,5vw,60px)] leading-none font-bold tracking-[-0.035em]">Pick your player. Join the crew.</h2>
            <p class="relative m-0 max-w-130 text-[17px] leading-relaxed text-[#b3b3b3]">
                One Discord for both extensions: presets, bugs, requests and early YouTube builds.
            </p>
            <div class="relative flex flex-wrap justify-center gap-3">
                <a href={LINKS.chrome} data-store-link data-firefox-href={LINKS.firefox} data-firefox-label="Chorus for Spotify" class="inline-flex min-h-12.5 items-center rounded-xl bg-[#1ed760] px-5 font-semibold text-[#0b0b0b]">
                    <span data-store-label>Chorus for Spotify</span>
                </a>
                <a href={YOUTUBE_EARLY_ACCESS} class="inline-flex min-h-12.5 items-center rounded-xl bg-[#e0002d] px-5 font-semibold text-white">Chorus for YouTube</a>
                <a href={LINKS.discord} class="inline-flex min-h-12.5 items-center rounded-xl border border-white/14 bg-white/8 px-5 font-semibold">Discord</a>
            </div>
        </div>
    </section>

    <script is:inline>
        // Static clips follow the reduced-motion preference too; the islands handle their own.
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            for (const video of document.querySelectorAll('video[autoplay]')) {
                video.removeAttribute('autoplay')
                video.pause()
            }
        }
    </script>
</Landing>
