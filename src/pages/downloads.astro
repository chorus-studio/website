---
import Landing from '../layouts/Landing.astro'

interface Asset {
    name: string
    browser_download_url: string
    size: number
}

interface Release {
    tag_name: string
    name: string
    published_at: string
    html_url: string
    prerelease: boolean
    assets: Asset[]
}

let releases: Release[] = []

try {
    const response = await fetch(
        'https://api.github.com/repos/chorus-studio/chorus/releases?per_page=30',
        {
            headers: {
                Accept: 'application/vnd.github.v3+json',
                'User-Agent': 'chorusstudio-website'
            }
        }
    )
    if (response.ok) {
        releases = await response.json()
    }
} catch {
    // Fallback handled below
}

const latest = releases.find((r) => !r.prerelease)

function formatDate(dateStr: string): string {
    return new Date(dateStr).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    })
}

function formatSize(bytes: number): string {
    return `${(bytes / 1024 / 1024).toFixed(1)} MB`
}

function getBrowserFromAsset(name: string): string {
    if (name.includes('chrome')) return 'Chrome'
    if (name.includes('firefox')) return 'Firefox'
    return 'Other'
}
---

<Landing title="Downloads | Chorus" description="Download Chorus for Chrome, Firefox, and other browsers.">
    <section class="px-6 py-24">
        <div class="mx-auto max-w-4xl">
            <div class="mb-16 text-center">
                <h1 class="mb-4 text-4xl font-bold">Downloads</h1>
                <p class="text-[#b3b3b3]">
                    Get Chorus from the official stores or download directly.
                </p>
            </div>

            <!-- Store Links -->
            <div class="mb-16 grid grid-cols-1 gap-6 md:grid-cols-2">
                <a
                    href="https://chromewebstore.google.com/detail/chorus-spotify-enhancer/jfnjmnapkhdbaidedlbdcmhiphfjljcd"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-4 rounded-xl border border-white/5 bg-[#181818] p-6 transition hover:border-[#1db954]/30"
                >
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1db954" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="21.17" y1="8" x2="12" y2="8"/><line x1="3.95" y1="6.06" x2="8.54" y2="14"/><line x1="10.88" y1="21.94" x2="15.46" y2="14"/></svg>
                    </div>
                    <div>
                        <div class="font-semibold">Chrome Web Store</div>
                        <div class="text-sm text-[#b3b3b3]">Chrome, Edge, Opera, Brave, Vivaldi</div>
                    </div>
                </a>
                <a
                    href="https://addons.mozilla.org/firefox/addon/chorus-spotify-enhancer/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-4 rounded-xl border border-white/5 bg-[#181818] p-6 transition hover:border-[#1db954]/30"
                >
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1db954" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                    </div>
                    <div>
                        <div class="font-semibold">Firefox Add-ons</div>
                        <div class="text-sm text-[#b3b3b3]">Firefox browser</div>
                    </div>
                </a>
            </div>

            <!-- GitHub Releases -->
            <h2 class="mb-8 text-2xl font-bold">All Releases</h2>

            {
                releases.length > 0 ? (
                    <div class="space-y-4">
                        {releases.map((release, i) => (
                            <div
                                class:list={[
                                    'rounded-xl border bg-[#181818] p-5',
                                    i === 0 && !release.prerelease
                                        ? 'border-[#1db954]/30'
                                        : 'border-white/5'
                                ]}
                            >
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <div class="flex flex-wrap items-center gap-3">
                                        <span class="text-lg font-bold">{release.tag_name}</span>
                                        {release === latest && (
                                            <span class="rounded-full bg-[#1db954]/10 px-3 py-0.5 text-xs font-medium text-[#1db954]">
                                                Latest
                                            </span>
                                        )}
                                        {release.prerelease && (
                                            <span class="rounded-full bg-yellow-500/10 px-3 py-0.5 text-xs font-medium text-yellow-400">
                                                Beta
                                            </span>
                                        )}
                                        <span class="text-sm text-[#b3b3b3]">
                                            {formatDate(release.published_at)}
                                        </span>
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {release.assets
                                            .filter((a) => a.name.endsWith('.zip'))
                                            .map((asset) => (
                                                <a
                                                    href={asset.browser_download_url}
                                                    class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 px-3 py-1.5 text-xs font-medium transition hover:border-[#1db954]/30 hover:text-[#1db954]"
                                                >
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="14"
                                                        height="14"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                                        <polyline points="7 10 12 15 17 10" />
                                                        <line x1="12" y1="15" x2="12" y2="3" />
                                                    </svg>
                                                    {getBrowserFromAsset(asset.name)}{' '}
                                                    <span class="text-[#b3b3b3]">
                                                        ({formatSize(asset.size)})
                                                    </span>
                                                </a>
                                            ))}
                                        <a
                                            href={release.html_url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 px-3 py-1.5 text-xs font-medium transition hover:border-white/30"
                                        >
                                            Release Notes
                                        </a>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                ) : (
                    <div class="rounded-xl border border-white/5 bg-[#181818] p-12 text-center">
                        <p class="mb-4 text-[#b3b3b3]">
                            Unable to load releases. Check GitHub directly.
                        </p>
                        <a
                            href="https://github.com/chorus-studio/chorus/releases"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[#1db954] hover:underline"
                        >
                            View releases on GitHub
                        </a>
                    </div>
                )
            }
        </div>
    </section>
</Landing>
